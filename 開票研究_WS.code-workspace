{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "啟動開票研究",
				"type": "debugpy",
				"request": "launch",
				"module": "http.server",
				"args": ["8000", "--bind", "127.0.0.1"],
				"cwd": "${workspaceFolder:開票研究}",
				"pythonArgs": ["-u", "-B"],
				"console": "internalConsole",
				"justMyCode": true,
				"serverReadyAction": {
					"pattern": "Serving HTTP on 127\\.0\\.0\\.1 port ([0-9]+)",
					"uriFormat": "http://127.0.0.1:%s/index.html",
					"action": "openExternally"
				}
			}
		]
	}
}
